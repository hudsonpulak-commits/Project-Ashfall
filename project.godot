; Engine configuration file.
; Ashfen — original top-down skilling RPG. Godot 4.7, Compatibility renderer.

config_version=5

[application]

config/name="Ashfen"
config/description="Original top-down tile skilling RPG with a living, AI-driven world."
config/version="0.3.14"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.07, 0.086, 0.06, 1)
boot_splash/show_image=false
run/low_processor_mode=false

[autoload]

GameData="*res://autoload/game_data.gd"
Tick="*res://autoload/tick.gd"
Events="*res://autoload/events.gd"
SaveSystem="*res://autoload/save_system.gd"
Market="*res://autoload/market.gd"
AIDirector="*res://autoload/ai_director.gd"
DayNight="*res://autoload/day_night.gd"
Music="*res://autoload/music.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=360
window/size/window_height_override=720
window/stretch/mode="disabled"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.07, 0.086, 0.06, 1)

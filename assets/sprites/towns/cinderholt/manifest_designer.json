 "diag_autotiles": {
  "rule": "45-degree corner autotiles (shared by Saltmere v2 and Highfen v3.1).\nMask = which tile CORNERS are inside the terrain: NW=1, NE=2, SE=4, SW=8 (16 frames, frame index = mask).\nA set corner owns the 45deg diamond around it (|dx|+|dy|<=8 px); two set corners on one side own that half tile.\n=> 1 corner = outer 45deg diagonal cut, 3 corners = inner 45deg diagonal, 2 adjacent = straight edge, 2 opposite = saddle.\nA 45deg run alternates diag_out_* / diag_in_* tiles; a straight edge meeting a diag is the straight->diagonal transition.\nSample the shape on the (GH+1)x(GW+1) vertex grid; tile (y,x) frame = V[y,x]*1+V[y,x+1]*2+V[y+1,x+1]*4+V[y+1,x]*8.",
  "frame_names": {
   "0": "empty",
   "15": "full",
   "3": "edge_n",
   "6": "edge_e",
   "12": "edge_s",
   "9": "edge_w",
   "1": "diag_out_nw",
   "2": "diag_out_ne",
   "4": "diag_out_se",
   "8": "diag_out_sw",
   "14": "diag_in_nw",
   "13": "diag_in_ne",
   "11": "diag_in_se",
   "7": "diag_in_sw",
   "5": "saddle_nw_se",
   "10": "saddle_ne_sw"
  },
  "sheets": [
   "tiles/ch_diag_ash_drift.png",
   "tiles/ch_diag_cobble_road.png",
   "tiles/ng_diag_yard_dirt.png",
   "tiles/ch_diag_basalt_wall.png",
   "tiles/ng_diag_palisade.png"
  ],
  "named": "tiles/named/<sheet>_<frame>.png",
  "walls": "ch_diag_basalt_wall / ng_diag_palisade: 16x30 frames, top + 14px south face hanging into the next row; draw rows top->bottom, y-sorted with sprites",
  "layering": "ch_scorched_fill_a/b -> ch_diag_ash_drift -> ch_diag_cobble_road / ng_diag_yard_dirt -> wall rows / sprites"
 },
